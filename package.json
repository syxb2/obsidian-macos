{
  "name": "obsidian-macos",
  "version": "1.1.0",
  "description": "A Baseline 3.2.12 theme with both sidebars docked and the options removed",
  "private": true,
  "scripts": {
    "build": "sass --no-source-map --no-charset --style=compressed src/theme.scss theme.css",
    "watch": "sass --no-source-map --no-charset --watch src/theme.scss theme.css"
  },
  "devDependencies": {
    "sass": "^1.104.1"
  }
}
